# Configurações do Redis Cloud (Copie este arquivo para .env e preencha com suas credenciais)
REDIS_HOST=seu-endpoint.redislabs.com
REDIS_PORT=12675
REDIS_USER=default
REDIS_PASSWORD=coloque_sua_senha_aqui
REDIS_DATABASE_NAME=nome-do-seu-database
REDIS_URL=redis://default:coloque_sua_senha_aqui@seu-endpoint.redislabs.com:12675
